# Optional but recommended: free Demo API key from https://www.coingecko.com/en/developers/dashboard
# Without a key CoinGecko's keyless limit is much lower and the first load is slower.
COINGECKO_API_KEY=

# Requests per minute we allow ourselves against CoinGecko (Demo plan ~30/min).
# Leave empty to auto-pick: 25 with a key, 8 without.
COINGECKO_RATE_LIMIT_PER_MIN=

# How many pages of 250 coins (ordered by market cap) to scan.
MARKET_PAGES=2

# Cap on per-coin /coins/{id} calls per refresh (each candidate needs one).
MAX_DETAIL_FETCHES=60

MARKETS_CACHE_TTL_SECONDS=300
DETAILS_CACHE_TTL_SECONDS=1800

# JSON list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173"]
